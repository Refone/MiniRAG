  "cards": [
    {
      "dot": "cyan",
      "title": "分层契约",
      "items": [
        "api → service → graphs → common 单向依赖",
        "common 内部 tier 0–4，只允许高 tier 依赖低 tier",
        "tools/check_layers.py 校验层级，backend 启动自检校验三类基础设施"
      ]
    },
    {
      "dot": "emerald",
      "title": "运行态与流式推送",
      "items": [
        "TASK_MANAGER / EVENT_BUS 为进程内状态，当前仅支持单 worker",
        "任务进度、子任务状态与答案 delta 经 SSE 由 FastAPI 流式回推",
        "外部依赖统一经访问器惰性构造，测试可用 seam 替换"
      ]
    },
    {
      "dot": "violet",
      "title": "数据与模型",
      "items": [
        "Milvus 存 docs / chunks 混合向量（稠密 + 稀疏）",
        "MinIO 存 Markdown、图片与 chunks；MongoDB 存会话历史与 Token 用量",
        "DeepSeek 生成答案；Qwen Embedding / Reranker / VLM 负责向量、精排与识图"
      ]
    }
  ]
