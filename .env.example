# ===================== 目录配置 =====================
# MinerU 导入临时目录
OUTPUT_DIR_IMPORT_TMP_DIR="var/import"
# 上传临时目录
OUTPUT_DIR_UPLOAD_TMP_DIR="var/uploads"
# 日志目录
OUTPUT_DIR_LOG_DIR="var/logs"
# 节点调试快照 / 脚本临时产物 (chunks.json 等)
OUTPUT_DIR_TMP_DIR="var/tmp"

# ===================== 日志配置 =====================
# 日志级别: DEBUG | INFO | WARNING | ERROR

# 控制台是否输出
LOG_CONSOLE_ENABLE=True
# 控制台日志级别
LOG_CONSOLE_LEVEL=DEBUG
# 是否输出日志文件
LOG_FILE_ENABLE=False
# 日志文件输出级别
LOG_FILE_LEVEL=DEBUG
# 日志文件保留天数, 自动删除过期日志
LOG_FILE_RETENTION="7 days"

# ===================== MinerU 配置 =====================
# 官方 API 接入: https://mineru.net/apiManage/docs
# MinerU API 地址
MINERU_BASE_URL="https://mineru.net/api/v4"
# MinerU API 密钥
MINERU_API_KEY="sk-************************************************"

# ===================== MinIO 配置 =====================
# MinIO 是一个高性能的对象存储服务, 用于存储文件
# https://docs.min.io/docs/minio-client-complete-guide.html
# https://www.minio.org.cn/docs/minio/linux/developers/python/API.html#
# MinIO 服务器地址
MINIO_ENDPOINT="127.0.0.1:9000"
# MinIO 用户名
MINIO_ACCESS_KEY="**********"
# MinIO 密码
MINIO_SECRET_KEY="**********"
# MinIO 存储桶名
MINIO_BUCKET_NAME="minirag"
# MinIO 存储图片的目录
MINIO_IMAGE_DIR="markdown-images"
# 文档三份制品的目录, 对象路径 <dir>/<file_title>/<文件名>
# 原始文件
MINIO_ORIGIN_DIR="origin-files"
# 最终 markdown
MINIO_MARKDOWN_DIR="final-markdowns"
# chunks.json
MINIO_CHUNKS_DIR="chunks-json"
# 是否使用 https/TLS 加密连接
MINIO_SECURE=False

# ===================== Milvus 配置 =====================
MILVUS_ENDPOINT="http://127.0.0.1:19530"
# 文档元数据集合
MILVUS_COLLECTION_DOCS="minirag_docs"
# 切片集合
MILVUS_COLLECTION_CHUNKS="minirag_chunks"

# ===================== MongoDB 配置 =====================
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB_NAME="minirag"

# ===================== 阿里云百炼 =====================
DASHSCOPE_API_KEY="sk-******************************************************************************************************************"
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# LLM 配置
# https://www.qianwenai.com/models/deepseek-v4.1-flash
DASHSCOPE_LLM_MODEL="deepseek-v4.1-flash"
DASHSCOPE_LLM_RPM=500

# VLM (视觉语言模型) 配置
# https://www.qianwenai.com/models/qwen3-vl-plus
DASHSCOPE_VLM_MODEL="qwen3-vl-plus"
DASHSCOPE_VLM_RPM=3000

# Embedding 配置
# https://www.qianwenai.com/models/text-embedding-v4
DASHSCOPE_EMBEDDING_MODEL="text-embedding-v4"
DASHSCOPE_EMBEDDING_RPM=1000
DASHSCOPE_EMBEDDING_DENSE_DIMENSION=1024
# text-embedding-v4 单次 10 行，每行最大 Token 8192
# https://help.aliyun.com/zh/model-studio/text-embedding-synchronous-api?spm=a2c4g.11186623.help-menu-2400256.d_2_9_0_0.25332dec7UlfWf
DASHSCOPE_EMBEDDING_BATCH_SIZE=10

# Reranker 配置
# https://www.qianwenai.com/models/qwen3.7-text-rerank
DASHSCOPE_RERANK_MODEL="qwen3.7-text-rerank"
DASHSCOPE_RERANK_RPM=3000
DASHSCOPE_RERANK_MAX_TEXT_LENGTH=30000

# Web Search MCP 配置
DASHSCOPE_WEB_SEARCH_MCP_URL="https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp"
DASHSCOPE_WEB_SEARCH_MCP_TOOL_NAME="bailian_web_search"
